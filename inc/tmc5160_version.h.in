/**
 * @file tmc5160_version.h
 * @brief TMC5160 driver version, generated by CMake from tmc5160_version.h.in.
 * @copyright Copyright (c) 2026 The driver-tmc5160 authors. SPDX-License-Identifier: MIT
 *
 * Do not edit the generated file: the version is set once, in cmake/tmc5160_build_settings.cmake, and
 * configure_file() writes it here.
 */
#ifndef TMC5160_VERSION_H
#define TMC5160_VERSION_H

/** Major version: incompatible API changes. */
#define TMC5160_VERSION_MAJOR @TMC5160_VERSION_MAJOR@
/** Minor version: features added compatibly. */
#define TMC5160_VERSION_MINOR @TMC5160_VERSION_MINOR@
/** Patch version: fixes. */
#define TMC5160_VERSION_PATCH @TMC5160_VERSION_PATCH@
/** Full version string, for example "0.1.0". */
#define TMC5160_VERSION_STRING "@TMC5160_VERSION@"

#endif // TMC5160_VERSION_H
